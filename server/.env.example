# FITZONE — variables de entorno (copia a .env para desarrollo local)
#
# En Railway: crea el plugin PostgreSQL y define DATABASE_URL automáticamente;
# además define AUTH_SECRET y ADMIN_INITIAL_PASSWORD en Variables.

# Obligatoria. PostgreSQL local o de Railway.
DATABASE_URL=postgresql://user:pass@localhost:5432/fitzone_dev

# Puerto del servidor (Railway lo inyecta automáticamente).
PORT=3001

# Obligatoria en producción (mínimo 16 caracteres). En dev se genera un secreto efímero.
AUTH_SECRET=

# Contraseña inicial del admin admin@fitzone.com (mínimo 8 caracteres).
# Si no se define, se genera una aleatoria y se imprime UNA vez en consola al primer arranque.
ADMIN_INITIAL_PASSWORD=

# Origen permitido para CORS en producción (p.ej. https://tu-app.up.railway.app).
# En dev se permite http://localhost:* implícitamente.
CLIENT_ORIGIN=

# Opcional. Clave de Google Gemini para mensajes IA de seguimiento.
GEMINI_API_KEY=

# NOTA OPERATIVA (B11): la sesión de WhatsApp (whatsapp_auth/) es local y efímera.
# Tras cada redeploy en Railway hay que re-escanear el QR desde el módulo de WhatsApp.
# Evaluar volumen/almacenamiento persistente en la Fase E.
