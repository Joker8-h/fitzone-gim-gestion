datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("ADMIN") // "ADMIN" | "STAFF"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id               String             @id @default(uuid())
  documentId       String             @unique // Cedula / Documento de identidad
  fullName         String
  phone            String
  registrationDate DateTime           @default(now())
  status           String             @default("ACTIVO") // "ACTIVO" | "INACTIVO"
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  memberships      ClientMembership[]
  payments         Payment[]
  attendances      Attendance[]
  communications   CommunicationLog[]
}

model MembershipPlan {
  id           String             @id @default(uuid())
  name         String
  durationDays Int
  price        Float
  description  String?
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())

  memberships  ClientMembership[]
}

model ClientMembership {
  id         String         @id @default(uuid())
  clientId   String
  planId     String
  startDate  DateTime
  endDate    DateTime
  status     String         @default("VIGENTE") // "VIGENTE" | "POR_VENCER" | "VENCIDA"
  pricePaid  Float
  createdAt  DateTime       @default(now())

  client     Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan       MembershipPlan @relation(fields: [planId], references: [id])
  payments   Payment[]
}

model Payment {
  id             String                @id @default(uuid())
  clientId       String
  membershipId   String?
  amount         Float
  paymentMethod  String                // "EFECTIVO" | "NEQUI" | "DAVIPLATA" | "TRANSFERENCIA" | "TARJETA"
  reference      String?
  notes          String?
  createdAt      DateTime              @default(now())

  client         Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  membership     ClientMembership?     @relation(fields: [membershipId], references: [id])
  transaction    FinancialTransaction?
}

model Attendance {
  id             String   @id @default(uuid())
  clientId       String
  checkInTime    DateTime @default(now())
  wasOverridden  Boolean  @default(false)
  overrideReason String?
  registeredBy   String?

  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model FinancialCategory {
  id           String                 @id @default(uuid())
  name         String
  type         String                 // "INGRESO" | "EGRESO"
  isSystem     Boolean                @default(false)
  createdAt    DateTime               @default(now())

  transactions FinancialTransaction[]
}

model FinancialTransaction {
  id           String             @id @default(uuid())
  type         String             // "INGRESO" | "EGRESO"
  categoryId   String?
  concept      String
  amount       Float
  date         DateTime           @default(now())
  paymentId    String?            @unique
  registeredBy String?
  createdAt    DateTime           @default(now())

  category     FinancialCategory? @relation(fields: [categoryId], references: [id])
  payment      Payment?           @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model TrackingRule {
  id              String   @id @default(uuid())
  ruleType        String   @unique // "INACTIVITY" | "EXPIRING_MEMBERSHIP"
  thresholdDays   Int      // ej: 5 para inactividad, 3 para por vencer
  isEnabled       Boolean  @default(true)
  messageTemplate String
  updatedAt       DateTime @updatedAt
}

model CommunicationLog {
  id           String   @id @default(uuid())
  clientId     String
  ruleType     String
  message      String
  status       String   @default("SENT") // "PREPARED" | "SENT" | "FAILED"
  sentAt       DateTime @default(now())
  responseInfo String?

  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String   // "CREATE", "UPDATE", "DELETE", "OVERRIDE_CHECKIN"
  entity      String   // "Client", "Payment", etc.
  entityId    String?
  details     String?
  performedBy String?
  createdAt   DateTime @default(now())
}
